    <!-- Article 2 -->
    <item>
        <title>Outcome Analysis: Robotic-Assisted Stroke Recovery</title>
        <link>https://yourdomain.com/news/robotic-stroke-recovery</link>
        <pubDate>Tue, 12 Mar 2024 00:00:00 +0000</pubDate>
        <dc:creator><![CDATA[admin]]></dc:creator>
        <content:encoded><![CDATA[<p>Evaluating the efficacy of our M-1 series informatics on upper-limb motor recovery in chronic stroke patients over a 12-week period. This multi-center study enrolled 148 patients across 6 rehabilitation facilities.</p><h2>Study Design</h2><p>Patients were randomized to either the Motion Informatics STIMEL-03 protocol or standard physiotherapy. Primary endpoints included Fugl-Meyer Assessment scores and grip strength measurements.</p><h2>Results</h2><p>The STIMEL-03 group demonstrated statistically significant improvements across all primary endpoints (p &lt; 0.001), with a mean 31% improvement in Fugl-Meyer scores compared to 14% in the control group.</p>]]></content:encoded>
        <excerpt:encoded><![CDATA[Evaluating the efficacy of our M-1 series informatics on upper-limb motor recovery in chronic stroke patients over a 12-week period.]]></excerpt:encoded>
        <wp:post_id>101</wp:post_id>
        <wp:post_date><![CDATA[2024-03-12 00:00:00]]></wp:post_date>
